#include <stdio.h>
#include <stdlib.h>
typedef struct element {
	int broj;
	struct element *next;
} element;

element* dodajPocetak(element* glava,int x) {
	element *novi = (element*)malloc(sizeof(element));
	novi->broj=x;
	novi->next=glava;

	return novi;


}

element* dodajKraj(element* glava, int x) {

	element *novi = (element*)malloc(sizeof(element));
	novi->next=NULL;
	novi->broj=x;
	if (glava == NULL) return novi;
	element* p=glava;
 
 
	while(p->next!=NULL) {
		p=p->next;
	}
	p->next=novi;

	return glava;


}

